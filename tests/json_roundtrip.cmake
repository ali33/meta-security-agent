# Parses the hostile JSON emitted by `metasec_tests --emit-json` with CMake's own JSON parser.
execute_process(COMMAND "${EXE}" --emit-json
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "emit-json failed rc=${rc}: ${err}")
endif()

string(JSON host ERROR_VARIABLE e GET "${out}" hostname)
if(e)
  message(FATAL_ERROR "not valid JSON: ${e}\n${out}")
endif()
# "a\"b\c<LF>d<TAB>e<0x01><invalid byte -> U+FFFD>end"
string(FIND "${host}" "a\"b\\c" p0)
if(NOT p0 EQUAL 0)
  message(FATAL_ERROR "hostname did not round-trip: [${host}]")
endif()
string(FIND "${host}" "end" pend)
if(pend LESS 0)
  message(FATAL_ERROR "hostname tail lost: [${host}]")
endif()

string(JSON id GET "${out}" checks 0 check_id)
if(NOT id STREQUAL "x\"y")
  message(FATAL_ERROR "check_id did not round-trip: [${id}]")
endif()
string(JSON src GET "${out}" checks 0 source)
if(NOT src STREQUAL "src\\")
  message(FATAL_ERROR "source did not round-trip: [${src}]")
endif()
string(JSON ev ERROR_VARIABLE e2 GET "${out}" checks 0 evidence "k\"ey")
if(e2)
  message(FATAL_ERROR "evidence key with quote missing: ${e2}")
endif()
string(JSON st GET "${out}" checks 0 state)
if(NOT st STREQUAL "UNKNOWN")
  message(FATAL_ERROR "state: ${st}")
endif()
