# End-to-end CLI checks. Usage: cmake -DEXE=<meta-sec> -DMODE=<name> -P cli_check.cmake
# status exits 0 (OBSERVED) or 3 (INCOMPLETE) depending on the machine; both are valid reads.

function(run)
  execute_process(COMMAND "${EXE}" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  set(RC "${rc}" PARENT_SCOPE)
  set(OUT "${out}" PARENT_SCOPE)
  set(ERR "${err}" PARENT_SCOPE)
endfunction()

function(expect_rc)
  if(NOT RC IN_LIST ARGN)
    message(FATAL_ERROR "exit code ${RC} not in [${ARGN}]\nstdout: ${OUT}\nstderr: ${ERR}")
  endif()
endfunction()

function(expect_empty_stderr)
  if(NOT ERR STREQUAL "")
    message(FATAL_ERROR "unexpected stderr output: ${ERR}")
  endif()
endfunction()

function(expect_json_status)
  string(JSON ver ERROR_VARIABLE jerr GET "${OUT}" schema_version)
  if(jerr OR NOT ver EQUAL 1)
    message(FATAL_ERROR "stdout is not valid JSON with schema_version 1: ${jerr}
${OUT}")
  endif()
  string(JSON overall GET "${OUT}" overall)
  if(NOT overall MATCHES "^(OBSERVED|OBSERVED_WITH_ISSUES|INCOMPLETE)$")
    message(FATAL_ERROR "bad overall: ${overall}")
  endif()
  if(overall STREQUAL "INCOMPLETE" AND NOT RC EQUAL 3)
    message(FATAL_ERROR "INCOMPLETE must exit 3, got ${RC}")
  endif()
  if(NOT overall STREQUAL "INCOMPLETE" AND NOT RC EQUAL 0)
    message(FATAL_ERROR "${overall} must exit 0, got ${RC}")
  endif()

  # Exactly the six documented checks, each once.
  set(expected firewall.domain firewall.private firewall.public
      antivirus.windows_security_center antivirus.defender.antivirus
      antivirus.defender.realtime_protection)
  string(JSON n LENGTH "${OUT}" checks)
  list(LENGTH expected nexp)
  if(NOT n EQUAL nexp)
    message(FATAL_ERROR "expected ${nexp} checks, got ${n}")
  endif()
  set(seen "")
  set(any_incomplete FALSE)
  set(any_attention FALSE)
  set(fw_observed 0)
  set(attention_expected "")
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    foreach(field check_id observed_at_utc state posture source error_code evidence)
      string(JSON v ERROR_VARIABLE e GET "${OUT}" checks ${i} ${field})
      if(e)
        message(FATAL_ERROR "check ${i} lacks '${field}': ${e}")
      endif()
    endforeach()
    string(JSON id GET "${OUT}" checks ${i} check_id)
    string(JSON st GET "${OUT}" checks ${i} state)
    string(JSON ec GET "${OUT}" checks ${i} error_code)
    string(JSON po GET "${OUT}" checks ${i} posture)
    list(APPEND seen "${id}")
    if(NOT id IN_LIST expected)
      message(FATAL_ERROR "unexpected check_id ${id}")
    endif()
    if(NOT st MATCHES "^(ENABLED|DISABLED|GOOD|POOR|SNOOZE|NOT_MONITORED|PASSIVE|UNKNOWN|NOT_SUPPORTED)$")
      message(FATAL_ERROR "${id}: bad state ${st}")
    endif()
    if(st MATCHES "^(UNKNOWN|NOT_SUPPORTED|NOT_MONITORED)$")
      set(any_incomplete TRUE)
    endif()
    # failed call <=> UNKNOWN/NOT_SUPPORTED with a non-empty error_code (both directions)
    if(st MATCHES "^(UNKNOWN|NOT_SUPPORTED)$" AND ec STREQUAL "")
      message(FATAL_ERROR "${id}: ${st} without error_code")
    endif()
    if(NOT ec STREQUAL "" AND NOT st MATCHES "^(UNKNOWN|NOT_SUPPORTED)$")
      message(FATAL_ERROR "${id}: error_code '${ec}' with positive state ${st}")
    endif()
    if(st MATCHES "^(DISABLED|POOR|SNOOZE|NOT_MONITORED)$")
      set(any_attention TRUE)
      list(APPEND attention_expected "${id}")
      if(NOT po STREQUAL "ATTENTION")
        message(FATAL_ERROR "${id}: ${st} must have posture ATTENTION, got ${po}")
      endif()
    endif()
    if(id MATCHES "^firewall\." AND NOT st MATCHES "^(UNKNOWN|NOT_SUPPORTED)$")
      math(EXPR fw_observed "${fw_observed} + 1")
    endif()
  endforeach()
  list(SORT seen)
  list(SORT expected)
  if(NOT seen STREQUAL expected)
    message(FATAL_ERROR "check ids differ: ${seen} vs ${expected}")
  endif()
  if(fw_observed LESS 1)
    message(FATAL_ERROR "no firewall profile was actually observed")
  endif()

  # overall must agree with the checks, in both directions
  if(any_incomplete AND NOT overall STREQUAL "INCOMPLETE")
    message(FATAL_ERROR "incomplete check but overall=${overall}")
  endif()
  if(NOT any_incomplete AND overall STREQUAL "INCOMPLETE")
    message(FATAL_ERROR "no incomplete check but overall=INCOMPLETE")
  endif()
  if(NOT any_incomplete AND any_attention AND NOT overall STREQUAL "OBSERVED_WITH_ISSUES")
    message(FATAL_ERROR "attention present but overall=${overall}")
  endif()
  if(NOT any_incomplete AND NOT any_attention AND NOT overall STREQUAL "OBSERVED")
    message(FATAL_ERROR "clean but overall=${overall}")
  endif()

  # attention[] lists exactly the ATTENTION checks
  string(JSON na LENGTH "${OUT}" attention)
  list(LENGTH attention_expected nae)
  if(NOT na EQUAL nae)
    message(FATAL_ERROR "attention has ${na} entries, expected ${nae}")
  endif()
endfunction()

function(expect_json_audit)
  string(JSON ver ERROR_VARIABLE jerr GET "${OUT}" schema_version)
  if(jerr OR NOT ver EQUAL 1)
    message(FATAL_ERROR "stdout is not valid JSON with schema_version 1: ${jerr}
${OUT}")
  endif()
  string(JSON cmd GET "${OUT}" command)
  if(NOT cmd STREQUAL "audit")
    message(FATAL_ERROR "command is '${cmd}', expected audit")
  endif()
  string(JSON overall GET "${OUT}" overall)
  string(JSON n LENGTH "${OUT}" rules)
  if(n LESS 6)
    message(FATAL_ERROR "audit must have at least 6 rules, got ${n}")
  endif()
  set(seen "")
  set(nfail 0)
  set(nunknown 0)
  set(npass 0)
  set(nna 0)
  math(EXPR last "${n} - 1")
  foreach(i RANGE ${last})
    foreach(field rule_id rule_version title result severity remediation evidence provenance)
      string(JSON v ERROR_VARIABLE e GET "${OUT}" rules ${i} ${field})
      if(e)
        message(FATAL_ERROR "rule ${i} lacks '${field}': ${e}")
      endif()
    endforeach()
    string(JSON id GET "${OUT}" rules ${i} rule_id)
    string(JSON res GET "${OUT}" rules ${i} result)
    string(JSON sev GET "${OUT}" rules ${i} severity)
    string(JSON rem GET "${OUT}" rules ${i} remediation)
    string(JSON ver_r GET "${OUT}" rules ${i} rule_version)
    string(JSON nev LENGTH "${OUT}" rules ${i} evidence)
    string(JSON nck LENGTH "${OUT}" rules ${i} provenance check_ids)
    if(id IN_LIST seen)
      message(FATAL_ERROR "duplicate rule_id ${id}")
    endif()
    list(APPEND seen "${id}")
    if(NOT id MATCHES "^META-[A-Z]+-[0-9][0-9][0-9]$")
      message(FATAL_ERROR "bad rule_id ${id}")
    endif()
    if(NOT ver_r MATCHES "^[1-9][0-9]*$")
      message(FATAL_ERROR "${id}: bad rule_version ${ver_r}")
    endif()
    if(NOT res MATCHES "^(PASS|FAIL|UNKNOWN|NOT_APPLICABLE)$")
      message(FATAL_ERROR "${id}: bad result ${res}")
    endif()
    if(NOT sev MATCHES "^(LOW|MEDIUM|HIGH|CRITICAL)$")
      message(FATAL_ERROR "${id}: bad severity ${sev}")
    endif()
    if(rem STREQUAL "" OR nev EQUAL 0 OR nck EQUAL 0)
      message(FATAL_ERROR "${id}: remediation, evidence and provenance must be non-empty")
    endif()
    if(res STREQUAL "FAIL")
      math(EXPR nfail "${nfail} + 1")
    elseif(res STREQUAL "UNKNOWN")
      math(EXPR nunknown "${nunknown} + 1")
      string(JSON why ERROR_VARIABLE e GET "${OUT}" rules ${i} evidence reason)
      if(e)
        message(FATAL_ERROR "${id}: UNKNOWN without evidence.reason")
      endif()
    elseif(res STREQUAL "PASS")
      math(EXPR npass "${npass} + 1")
    else()
      math(EXPR nna "${nna} + 1")
    endif()
  endforeach()
  # the seven documented rules, each once
  foreach(want META-FW-001 META-FW-002 META-FW-003 META-AV-001 META-AV-002 META-AV-003 META-AV-004)
    if(NOT want IN_LIST seen)
      message(FATAL_ERROR "missing rule ${want}")
    endif()
  endforeach()

  # summary agrees with the rules
  foreach(pair "pass;${npass}" "fail;${nfail}" "unknown;${nunknown}" "not_applicable;${nna}")
    list(GET pair 0 key)
    list(GET pair 1 want)
    string(JSON got GET "${OUT}" summary ${key})
    if(NOT got EQUAL want)
      message(FATAL_ERROR "summary.${key}=${got}, rules say ${want}")
    endif()
  endforeach()

  # overall and exit code agree, in both directions: FAIL <=> exit 1; no FAIL but UNKNOWN <=> 3
  if(nfail GREATER 0)
    set(want_overall FINDINGS)
    set(want_rc 1)
  elseif(nunknown GREATER 0)
    set(want_overall INCOMPLETE)
    set(want_rc 3)
  else()
    set(want_overall NO_FINDINGS)
    set(want_rc 0)
  endif()
  if(NOT overall STREQUAL want_overall)
    message(FATAL_ERROR "overall=${overall}, rules imply ${want_overall}")
  endif()
  if(NOT RC EQUAL want_rc)
    message(FATAL_ERROR "exit ${RC}, rules imply ${want_rc}")
  endif()
endfunction()

if(MODE STREQUAL "help")
  run(--help)
  expect_rc(0)
  expect_empty_stderr()
  if(NOT OUT MATCHES "meta-sec status")
    message(FATAL_ERROR "help text missing usage: ${OUT}")
  endif()
elseif(MODE STREQUAL "version")
  run(--version)
  expect_rc(0)
  expect_empty_stderr()
  if(NOT OUT MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+")
    message(FATAL_ERROR "unexpected version output: ${OUT}")
  endif()
elseif(MODE STREQUAL "status_text")
  run(status)
  expect_rc(0 3)
  expect_empty_stderr()
  if(NOT OUT MATCHES "Overall: (OBSERVED|OBSERVED_WITH_ISSUES|INCOMPLETE)")
    message(FATAL_ERROR "no overall line: ${OUT}")
  endif()
elseif(MODE STREQUAL "status_json")
  run(status --json)
  expect_rc(0 3)
  expect_json_status()
  expect_empty_stderr()
elseif(MODE STREQUAL "audit_text")
  run(audit)
  expect_rc(0 1 3)
  expect_empty_stderr()
  if(NOT OUT MATCHES "Overall: (NO_FINDINGS|FINDINGS|INCOMPLETE)")
    message(FATAL_ERROR "no overall line: ${OUT}")
  endif()
  if(NOT OUT MATCHES "META-FW-001" OR NOT OUT MATCHES "META-AV-004")
    message(FATAL_ERROR "rules missing from text report: ${OUT}")
  endif()
elseif(MODE STREQUAL "audit_json")
  run(audit --json)
  expect_rc(0 1 3)
  expect_json_audit()
  expect_empty_stderr()
  # Cross-check against `status` on the same machine: firewall rule results follow the observed states.
  set(audit_out "${OUT}")
  run(status --json)
  set(fw_checks firewall.domain firewall.private firewall.public)
  set(fw_rules META-FW-001 META-FW-002 META-FW-003)
  foreach(k RANGE 0 2)
    list(GET fw_checks ${k} cid)
    string(JSON st GET "${OUT}" checks ${k} state)
    string(JSON stid GET "${OUT}" checks ${k} check_id)
    string(JSON res GET "${audit_out}" rules ${k} result)
    string(JSON rid GET "${audit_out}" rules ${k} rule_id)
    list(GET fw_rules ${k} want_rid)
    if(NOT stid STREQUAL cid OR NOT rid STREQUAL want_rid)
      message(FATAL_ERROR "unexpected ordering: ${stid} / ${rid}")
    endif()
    if(st STREQUAL "ENABLED")
      set(want PASS)
    elseif(st STREQUAL "DISABLED")
      set(want FAIL)
    else()
      set(want UNKNOWN)
    endif()
    if(NOT res STREQUAL want)
      message(FATAL_ERROR "${rid} is ${res} but ${cid} is ${st}")
    endif()
  endforeach()
elseif(MODE STREQUAL "audit_bad_flag")
  run(audit --bogus)
  expect_rc(2)
  if(NOT OUT STREQUAL "")
    message(FATAL_ERROR "errors must go to stderr, stdout had: ${OUT}")
  endif()
  if(NOT ERR MATCHES "unexpected argument")
    message(FATAL_ERROR "stderr missing diagnostic: ${ERR}")
  endif()
elseif(MODE STREQUAL "watch_text")
  run(watch --interval 1 --max-polls 2)
  expect_rc(0 3)
  expect_empty_stderr()
  string(FIND "${OUT}" "[BASELINE]" p_base)
  string(FIND "${OUT}" "[STOPPED] max_polls after 2 polls" p_stop)
  if(p_base EQUAL -1 OR p_stop EQUAL -1)
    message(FATAL_ERROR "unexpected watch text output: ${OUT}")
  endif()
elseif(MODE STREQUAL "watch_json")
  run(watch --json --interval 1 --max-polls 3)
  expect_rc(0 3)
  expect_empty_stderr()
  string(REPLACE "\r\n" "\n" OUT "${OUT}")
  string(REGEX REPLACE "\n$" "" OUT "${OUT}")
  string(REPLACE ";" "\;" OUT "${OUT}")
  string(REPLACE "\n" ";" lines "${OUT}")
  list(LENGTH lines nl)
  if(nl LESS 2)
    message(FATAL_ERROR "expected at least baseline + stopped, got ${nl} lines")
  endif()
  set(idx 0)
  set(nchange 0)
  foreach(line IN LISTS lines)
    string(REPLACE "\;" ";" line "${line}")
    string(JSON ver ERROR_VARIABLE e GET "${line}" schema_version)
    if(e OR NOT ver EQUAL 1)
      message(FATAL_ERROR "line ${idx} is not valid JSON: ${e}\n${line}")
    endif()
    string(JSON cmd GET "${line}" command)
    string(JSON ev GET "${line}" event)
    string(JSON at GET "${line}" observed_at_utc)
    if(NOT cmd STREQUAL "watch" OR NOT at MATCHES "^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9:]+Z$")
      message(FATAL_ERROR "bad envelope on line ${idx}: ${line}")
    endif()
    if(idx EQUAL 0)
      if(NOT ev STREQUAL "baseline")
        message(FATAL_ERROR "first line must be the baseline, got ${ev}")
      endif()
      string(JSON nchk LENGTH "${line}" checks)
      if(nchk LESS 1)
        message(FATAL_ERROR "baseline has no checks")
      endif()
    elseif(ev STREQUAL "baseline")
      message(FATAL_ERROR "baseline repeated on line ${idx}: replay")
    elseif(NOT ev STREQUAL "stopped")
      math(EXPR nchange "${nchange} + 1")
      foreach(field check_id from to first_observed_at_utc confirmations source evidence)
        string(JSON v ERROR_VARIABLE e GET "${line}" ${field})
        if(e)
          message(FATAL_ERROR "event lacks '${field}': ${line}")
        endif()
      endforeach()
    endif()
    set(last_line "${line}")
    math(EXPR idx "${idx} + 1")
  endforeach()
  set(line "${last_line}")
  if(NOT ev STREQUAL "stopped")
    message(FATAL_ERROR "last line must be 'stopped', got ${ev}")
  endif()
  string(JSON why GET "${line}" reason)
  string(JSON polls GET "${line}" polls)
  string(JSON nev GET "${line}" events)
  if(NOT why STREQUAL "max_polls" OR NOT polls EQUAL 3 OR NOT nev EQUAL nchange)
    message(FATAL_ERROR "bad stopped line: ${line} (change lines: ${nchange})")
  endif()
elseif(MODE STREQUAL "watch_bad_args")
  foreach(bad "--interval;0" "--interval;3601" "--interval;x" "--max-polls;0" "--confirm;11" "--interval" "--bogus" "extra")
    run(watch ${bad})
    expect_rc(2)
    if(NOT OUT STREQUAL "")
      message(FATAL_ERROR "watch ${bad}: errors must go to stderr, stdout had: ${OUT}")
    endif()
    if(ERR STREQUAL "")
      message(FATAL_ERROR "watch ${bad}: stderr missing diagnostic")
    endif()
  endforeach()
elseif(MODE STREQUAL "scan_dry_run")
  # Dry run never asks and never scans: exit 0 (gate passes) or 4 (not applicable on this machine).
  run(scan --quick --dry-run)
  expect_rc(0 4)
  expect_empty_stderr()
  if(NOT OUT MATCHES "DRY RUN" OR OUT MATCHES "COMPLETED")
    message(FATAL_ERROR "bad dry-run text: ${OUT}")
  endif()
elseif(MODE STREQUAL "scan_json")
  run(scan --quick --dry-run --json)
  expect_rc(0 4)
  expect_empty_stderr()
  string(JSON ver ERROR_VARIABLE jerr GET "${OUT}" schema_version)
  if(jerr OR NOT ver EQUAL 1)
    message(FATAL_ERROR "scan --json is not valid JSON: ${jerr}\n${OUT}")
  endif()
  string(JSON cmd GET "${OUT}" command)
  string(JSON dry GET "${OUT}" dry_run)
  string(JSON st GET "${OUT}" status)
  string(JSON ec GET "${OUT}" exit_code)
  string(JSON att GET "${OUT}" start attempted)
  string(JSON asked GET "${OUT}" approval asked)
  if(NOT cmd STREQUAL "scan" OR NOT dry STREQUAL "ON" OR att STREQUAL "ON" OR asked STREQUAL "ON")
    message(FATAL_ERROR "dry run must not ask or start: ${OUT}")
  endif()
  if(NOT st MATCHES "^(DRY_RUN_WOULD_PROCEED|REFUSED_NOT_APPLICABLE)$" OR NOT ec EQUAL RC)
    message(FATAL_ERROR "status ${st} / exit_code ${ec} / rc ${RC} inconsistent")
  endif()
elseif(MODE STREQUAL "scan_no_approval")
  # SAFETY TEST: even with the exact confirmation phrase on a redirected stdin, nothing may start.
  # Passes on any machine: if Defender is not the primary engine the gate refuses, otherwise
  # approval is refused because stdin is a file, not a console. Never exit 0, never COMPLETED.
  set(inp "${CMAKE_CURRENT_LIST_DIR}/scan_confirm_input.tmp")
  file(WRITE "${inp}" "START QUICK SCAN\r\nSTART QUICK SCAN\r\n")
  execute_process(COMMAND "${EXE}" scan --quick --json
    INPUT_FILE "${inp}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(REMOVE "${inp}")
  if(NOT rc EQUAL 4)
    message(FATAL_ERROR "redirected stdin must be refused with exit 4, got ${rc}\nstdout: ${out}\nstderr: ${err}")
  endif()
  string(JSON st GET "${out}" status)
  string(JSON granted GET "${out}" approval granted)
  string(JSON att GET "${out}" start attempted)
  string(JSON reason GET "${out}" approval reason)
  if(NOT st MATCHES "^REFUSED_(NOT_APPLICABLE|NOT_APPROVED)$" OR granted STREQUAL "ON" OR att STREQUAL "ON")
    message(FATAL_ERROR "scan was not refused: ${out}")
  endif()
  if(st STREQUAL "REFUSED_NOT_APPROVED" AND NOT reason STREQUAL "NOT_A_CONSOLE")
    message(FATAL_ERROR "expected NOT_A_CONSOLE, got ${reason}")
  endif()
  # Same through a pipe-less NUL-like empty stdin.
  file(WRITE "${inp}" "")
  execute_process(COMMAND "${EXE}" scan --quick
    INPUT_FILE "${inp}" RESULT_VARIABLE rc2 OUTPUT_VARIABLE out2 ERROR_VARIABLE err2)
  file(REMOVE "${inp}")
  if(NOT rc2 EQUAL 4 OR out2 MATCHES "COMPLETED")
    message(FATAL_ERROR "empty stdin must be refused with exit 4, got ${rc2}\n${out2}")
  endif()
elseif(MODE STREQUAL "scan_bad_args")
  foreach(bad "scan" "scan;--json" "scan;--dry-run" "scan;--full" "scan;--custom;C:\\" "scan;--quick;--full" "scan;--quick;--yes" "scan;--quick;--force" "scan;--quick;--quick" "scan;--quick;extra")
    run(${bad})
    expect_rc(2)
    if(NOT OUT STREQUAL "")
      message(FATAL_ERROR "scan ${bad}: errors must go to stderr, stdout had: ${OUT}")
    endif()
    if(ERR STREQUAL "")
      message(FATAL_ERROR "scan ${bad}: stderr missing diagnostic")
    endif()
  endforeach()
elseif(MODE STREQUAL "service_bad_args")
  foreach(bad "service" "service;frobnicate" "service;status;--bogus" "service;status;extra" "service;status;--json;--json"
              "service;events;--limit;0" "service;events;--limit;201" "service;events;--limit;abc" "service;events;--limit"
              "service;install;--yes" "service;install;--force" "service;uninstall;--json;--json"
              "service;run" "service;run;--console;--scm" "service;run;--scm;--max-polls;3"
              "service;run;--max-polls;3" "service;run;--console;--pipe-name;a/b" "service;run;--console;--data-dir")
    run(${bad})
    expect_rc(2)
    if(NOT OUT STREQUAL "")
      message(FATAL_ERROR "service ${bad}: errors must go to stderr, stdout had: ${OUT}")
    endif()
    if(ERR STREQUAL "")
      message(FATAL_ERROR "service ${bad}: stderr missing diagnostic")
    endif()
  endforeach()
elseif(MODE STREQUAL "service_status")
  # A machine without the service (CI, dev) reads as NOT_INSTALLED with exit 0; an installed one as 0 or 3.
  run(service status --json)
  expect_rc(0 3)
  expect_empty_stderr()
  string(JSON ver ERROR_VARIABLE jerr GET "${OUT}" schema_version)
  if(jerr OR NOT ver EQUAL 1)
    message(FATAL_ERROR "service status --json is not valid JSON: ${jerr}\n${OUT}")
  endif()
  string(JSON cmd GET "${OUT}" command)
  string(JSON installed GET "${OUT}" service installed)
  string(JSON verdict GET "${OUT}" verdict)
  string(JSON overall GET "${OUT}" overall)
  if(NOT cmd STREQUAL "service status")
    message(FATAL_ERROR "bad command: ${cmd}")
  endif()
  if(NOT installed STREQUAL "ON")
    if(NOT RC EQUAL 0 OR NOT verdict STREQUAL "NOT_INSTALLED" OR NOT overall STREQUAL "OBSERVED")
      message(FATAL_ERROR "no service installed must read NOT_INSTALLED/OBSERVED with exit 0: rc=${RC}\n${OUT}")
    endif()
  endif()
  run(service status)
  expect_rc(0 3)
  expect_empty_stderr()
  if(NOT installed STREQUAL "ON" AND NOT OUT MATCHES "not installed")
    message(FATAL_ERROR "text output should say 'not installed': ${OUT}")
  endif()
elseif(MODE STREQUAL "service_status_json")
  # With an explicit pipe nobody listens on, the pipe is tried and reported unreachable; the SCM verdict decides the exit code.
  string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" rnd)
  run(service status --json --pipe-name "nosuch-${rnd}")
  expect_rc(0 3)
  expect_empty_stderr()
  string(JSON installed GET "${OUT}" service installed)
  string(JSON reach GET "${OUT}" ipc reach)
  string(JSON reachable GET "${OUT}" ipc reachable)
  if(NOT reach STREQUAL "UNREACHABLE" OR reachable STREQUAL "ON")
    message(FATAL_ERROR "nothing listens on that pipe, expected UNREACHABLE: ${OUT}")
  endif()
  if(NOT installed STREQUAL "ON" AND NOT RC EQUAL 0)
    message(FATAL_ERROR "not installed must exit 0: ${RC}\n${OUT}")
  endif()
elseif(MODE STREQUAL "service_events")
  # No service to ask: a clear message and exit 3 (could not observe), never a fallback to the database file.
  string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" rnd)
  run(service events --json --limit 5 --pipe-name "nosuch-${rnd}")
  expect_rc(3)
  expect_empty_stderr()
  string(JSON ver ERROR_VARIABLE jerr GET "${OUT}" schema_version)
  if(jerr OR NOT ver EQUAL 1)
    message(FATAL_ERROR "service events --json is not valid JSON: ${jerr}\n${OUT}")
  endif()
  string(JSON cmd GET "${OUT}" command)
  string(JSON reach GET "${OUT}" reach)
  string(JSON cnt GET "${OUT}" count)
  string(JSON lim GET "${OUT}" limit)
  if(NOT cmd STREQUAL "service events" OR NOT reach STREQUAL "UNREACHABLE" OR NOT cnt EQUAL 0 OR NOT lim EQUAL 5)
    message(FATAL_ERROR "unexpected events document: ${OUT}")
  endif()
  run(service events --pipe-name "nosuch-${rnd}")
  expect_rc(3)
  if(NOT OUT MATCHES "Could not read events")
    message(FATAL_ERROR "text output should explain why: ${OUT}")
  endif()
elseif(MODE STREQUAL "service_install_dry_run")
  # Dry run changes nothing. Not elevated => REFUSED_NOT_ELEVATED; elevated (CI) => the build directory is not
  # under Program Files, so the path rule refuses. Either way exit 4 and the service state is untouched.
  run(service status --json)
  string(JSON before GET "${OUT}" service installed)
  run(service install --dry-run --json)
  expect_rc(4)
  expect_empty_stderr()
  string(JSON ver ERROR_VARIABLE jerr GET "${OUT}" schema_version)
  if(jerr OR NOT ver EQUAL 1)
    message(FATAL_ERROR "service install --json is not valid JSON: ${jerr}\n${OUT}")
  endif()
  string(JSON cmd GET "${OUT}" command)
  string(JSON st GET "${OUT}" status)
  string(JSON ec GET "${OUT}" exit_code)
  string(JSON dry GET "${OUT}" dry_run)
  string(JSON att GET "${OUT}" change attempted)
  string(JSON asked GET "${OUT}" approval asked)
  if(NOT cmd STREQUAL "service install" OR NOT ec EQUAL 4 OR NOT dry STREQUAL "ON" OR att STREQUAL "ON" OR asked STREQUAL "ON")
    message(FATAL_ERROR "dry run must refuse (4) without asking or changing: ${OUT}")
  endif()
  if(NOT st MATCHES "^(REFUSED_NOT_ELEVATED|REFUSED_BAD_BINARY_PATH|REFUSED_ALREADY_INSTALLED)$")
    message(FATAL_ERROR "unexpected status ${st}: ${OUT}")
  endif()
  string(JSON allowed GET "${OUT}" binary allowed)
  if(allowed STREQUAL "ON")
    message(FATAL_ERROR "a build directory must never pass the protected-location rule: ${OUT}")
  endif()
  run(service status --json)
  string(JSON after GET "${OUT}" service installed)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "dry run changed the service state: ${before} -> ${after}")
  endif()
  run(service install --dry-run)
  expect_rc(4)
  if(NOT OUT MATCHES "DRY RUN" OR NOT OUT MATCHES "REFUSED")
    message(FATAL_ERROR "bad dry-run text: ${OUT}")
  endif()
elseif(MODE STREQUAL "service_install_no_approval")
  # SAFETY TEST: even with the exact phrase on a redirected stdin, nothing may be installed. The refusal
  # (not elevated / binary not in a protected directory) comes BEFORE any prompt, so CreateService can
  # never be reached from here, on any machine, elevated or not.
  run(service status --json)
  string(JSON before GET "${OUT}" service installed)
  set(inp "${CMAKE_CURRENT_LIST_DIR}/service_confirm_input.tmp")
  file(WRITE "${inp}" "INSTALL SERVICE\r\nINSTALL SERVICE\r\n")
  execute_process(COMMAND "${EXE}" service install --json
    INPUT_FILE "${inp}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(REMOVE "${inp}")
  if(NOT rc EQUAL 4)
    message(FATAL_ERROR "install with redirected stdin must be refused with exit 4, got ${rc}\nstdout: ${out}\nstderr: ${err}")
  endif()
  string(JSON st GET "${out}" status)
  string(JSON granted GET "${out}" approval granted)
  string(JSON att GET "${out}" change attempted)
  if(NOT st MATCHES "^REFUSED_" OR granted STREQUAL "ON" OR att STREQUAL "ON")
    message(FATAL_ERROR "install was not refused: ${out}")
  endif()
  # empty stdin as well
  file(WRITE "${inp}" "")
  execute_process(COMMAND "${EXE}" service install
    INPUT_FILE "${inp}" RESULT_VARIABLE rc2 OUTPUT_VARIABLE out2 ERROR_VARIABLE err2)
  file(REMOVE "${inp}")
  if(NOT rc2 EQUAL 4 OR out2 MATCHES "DONE")
    message(FATAL_ERROR "empty stdin must be refused with exit 4, got ${rc2}\n${out2}")
  endif()
  run(service status --json)
  string(JSON after GET "${OUT}" service installed)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "install attempt changed the service state: ${before} -> ${after}")
  endif()
elseif(MODE STREQUAL "service_uninstall")
  # Not installed: a valid no-op (exit 0) when elevated; refused (4) when not elevated, before anything else.
  run(service status --json)
  string(JSON before GET "${OUT}" service installed)
  set(inp "${CMAKE_CURRENT_LIST_DIR}/service_confirm_input2.tmp")
  file(WRITE "${inp}" "UNINSTALL SERVICE\r\n")
  execute_process(COMMAND "${EXE}" service uninstall --json
    INPUT_FILE "${inp}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(REMOVE "${inp}")
  string(JSON st ERROR_VARIABLE jerr GET "${out}" status)
  if(jerr)
    message(FATAL_ERROR "service uninstall --json is not valid JSON: ${jerr}\n${out}\n${err}")
  endif()
  string(JSON cmd GET "${out}" command)
  string(JSON att GET "${out}" change attempted)
  if(NOT cmd STREQUAL "service uninstall" OR att STREQUAL "ON")
    message(FATAL_ERROR "uninstall must not act from a redirected stdin: ${out}")
  endif()
  if(before STREQUAL "ON")
    if(NOT rc EQUAL 4 OR NOT st MATCHES "^REFUSED_")
      message(FATAL_ERROR "installed service + redirected stdin must be refused: rc=${rc}\n${out}")
    endif()
  else()
    if(NOT ((rc EQUAL 0 AND st STREQUAL "NO_OP_NOT_INSTALLED") OR (rc EQUAL 4 AND st STREQUAL "REFUSED_NOT_ELEVATED")))
      message(FATAL_ERROR "not installed: expected no-op (0) or not-elevated refusal (4), got rc=${rc} ${st}\n${out}")
    endif()
  endif()
  run(service status --json)
  string(JSON after GET "${OUT}" service installed)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "uninstall attempt changed the service state: ${before} -> ${after}")
  endif()
elseif(MODE STREQUAL "service_run_console")
  # Foreground observer: terminates by itself after --max-polls, creates its database, prints a start line
  # (stderr) and a closing summary (stdout), never touches ProgramData or the SCM.
  string(RANDOM LENGTH 12 ALPHABET "abcdefghijklmnopqrstuvwxyz0123456789" rnd)
  set(base "$ENV{TEMP}")
  if(base STREQUAL "")
    set(base "${CMAKE_CURRENT_LIST_DIR}")
  endif()
  set(dir "${base}/metasec-cli-${rnd}")
  file(REMOVE_RECURSE "${dir}")
  run(service run --console --max-polls 2 --interval 1 --data-dir "${dir}" --pipe-name "cli-${rnd}")
  expect_rc(0)
  if(NOT EXISTS "${dir}/events.db")
    message(FATAL_ERROR "events.db was not created in ${dir}\nstdout: ${OUT}\nstderr: ${ERR}")
  endif()
  if(NOT OUT MATCHES "\\[STOPPED\\] max_polls after 2 polls, [0-9]+ events, 0 store errors")
    message(FATAL_ERROR "unexpected closing line: ${OUT}")
  endif()
  if(NOT ERR MATCHES "service run --console: pipe .*cli-${rnd}, data dir ")
    message(FATAL_ERROR "start line (pipe name + data dir) missing on stderr: ${ERR}")
  endif()
  file(REMOVE_RECURSE "${dir}")
elseif(MODE STREQUAL "service_run_bad_args")
  foreach(bad "service;run;--console;--max-polls;0" "service;run;--console;--interval;0" "service;run;--console;--interval;99999"
              "service;run;--scm;--console" "service;run;--console;--console" "service;run;--console;--pipe-name;"
              "service;run;--console;--data-dir;a;--data-dir;b")
    run(${bad})
    expect_rc(2)
    if(NOT OUT STREQUAL "")
      message(FATAL_ERROR "service ${bad}: errors must go to stderr, stdout had: ${OUT}")
    endif()
  endforeach()
  # --scm from a terminal: the SCM is not our parent, so it says so and fails (2) instead of hanging
  run(service run --scm)
  expect_rc(2)
  if(NOT ERR MATCHES "Service Control Manager")
    message(FATAL_ERROR "expected an explanation on stderr: ${ERR}")
  endif()
elseif(MODE STREQUAL "bad_command")
  run(frobnicate)
  expect_rc(2)
  if(NOT OUT STREQUAL "")
    message(FATAL_ERROR "errors must go to stderr, stdout had: ${OUT}")
  endif()
  if(NOT ERR MATCHES "unknown command")
    message(FATAL_ERROR "stderr missing diagnostic: ${ERR}")
  endif()
elseif(MODE STREQUAL "bad_flag")
  run(status --bogus)
  expect_rc(2)
  if(NOT OUT STREQUAL "")
    message(FATAL_ERROR "errors must go to stderr, stdout had: ${OUT}")
  endif()
elseif(MODE STREQUAL "no_args")
  run()
  expect_rc(2)
  if(NOT OUT STREQUAL "")
    message(FATAL_ERROR "errors must go to stderr, stdout had: ${OUT}")
  endif()
else()
  message(FATAL_ERROR "unknown MODE '${MODE}'")
endif()
