# Parses the hostile policy report emitted by `metasec_policy_tests --emit-json` with CMake's own parser.
execute_process(COMMAND "${EXE}" --emit-json
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "emit-json failed rc=${rc}: ${err}")
endif()

string(JSON host ERROR_VARIABLE e GET "${out}" hostname)
if(e)
  message(FATAL_ERROR "not valid JSON: ${e}\n${out}")
endif()
string(FIND "${host}" "a\"b\\c" p0)
if(NOT p0 EQUAL 0)
  message(FATAL_ERROR "hostname did not round-trip: [${host}]")
endif()
string(JSON cmd GET "${out}" command)
if(NOT cmd STREQUAL "policy check")
  message(FATAL_ERROR "command: ${cmd}")
endif()
string(JSON n LENGTH "${out}" rules)
if(NOT n EQUAL 7)
  message(FATAL_ERROR "expected 7 rules, got ${n}")
endif()
# META-FW-003 (index 2) drifted; hostile source string and evidence survive.
string(JSON v GET "${out}" rules 2 verdict)
string(JSON src GET "${out}" rules 2 provenance sources 0)
string(JSON det GET "${out}" rules 2 observed evidence detail)
if(NOT v STREQUAL "DRIFT" OR NOT src STREQUAL "src\"x")
  message(FATAL_ERROR "verdict ${v} / source [${src}]")
endif()
string(FIND "${det}" "line1\nline2" p1)
if(p1 EQUAL -1)
  message(FATAL_ERROR "evidence did not round-trip: [${det}]")
endif()
string(JSON overall GET "${out}" overall)
if(NOT overall STREQUAL "DRIFT")
  message(FATAL_ERROR "overall: ${overall}")
endif()
