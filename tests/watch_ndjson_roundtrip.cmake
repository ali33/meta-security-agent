# Parses every line of the hostile NDJSON stream from `metasec_watch_tests --emit-ndjson`
# with CMake's own JSON parser, and checks the event sequence.
execute_process(COMMAND "${EXE}" --emit-ndjson
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "emit-ndjson failed rc=${rc}: ${err}")
endif()
string(REPLACE "\r\n" "\n" out "${out}")
string(REGEX REPLACE "\n$" "" out "${out}")
string(REPLACE ";" "\\;" out "${out}")
string(REPLACE "\n" ";" lines "${out}")
list(LENGTH lines n)

set(events "")
foreach(line IN LISTS lines)
  string(REPLACE "\\;" ";" line "${line}")
  string(JSON ver ERROR_VARIABLE e GET "${line}" schema_version)
  if(e OR NOT ver EQUAL 1)
    message(FATAL_ERROR "line is not valid JSON: ${e}\n${line}")
  endif()
  string(JSON cmd GET "${line}" command)
  string(JSON ev GET "${line}" event)
  string(JSON at GET "${line}" observed_at_utc)
  if(NOT cmd STREQUAL "watch" OR NOT at MATCHES "^[0-9]+-[0-9]+-[0-9]+T[0-9:]+Z$")
    message(FATAL_ERROR "bad envelope: ${line}")
  endif()
  list(APPEND events "${ev}")
  if(ev STREQUAL "baseline")
    string(JSON host GET "${line}" hostname)
    string(FIND "${host}" "a\"b\\c" p0)
    if(NOT p0 EQUAL 0)
      message(FATAL_ERROR "hostname did not round-trip: [${host}]")
    endif()
  elseif(ev STREQUAL "change")
    string(JSON src GET "${line}" source)
    if(NOT src STREQUAL "src\"x\\")
      message(FATAL_ERROR "source did not round-trip: [${src}]")
    endif()
    string(JSON evv GET "${line}" evidence "k\"")
    if(NOT evv STREQUAL "v\n\\")
      message(FATAL_ERROR "evidence did not round-trip: [${evv}]")
    endif()
  endif()
endforeach()

# E E->D D (confirmed D) -> U U (lost) -> E E (restored) -> stopped
set(want "baseline;change;observation_lost;observation_restored;stopped")
if(NOT events STREQUAL want)
  message(FATAL_ERROR "events [${events}] != [${want}]")
endif()
